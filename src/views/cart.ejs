<%- include('partials/header') %>
<div class="container py-4">
  <h1 class="h3 fw-bold mb-4">Your Cart</h1>

  <% if (!cart.length) { %>
    <div class="alert alert-info">Your cart is empty. <a href="/menu">Browse menu</a></div>
  <% } else { %>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="table-responsive bg-white rounded-4 shadow-sm p-3">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% cart.forEach(item => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <img src="<%= item.image %>" class="cart-item-img rounded" alt="<%= item.name %>" />
                      <span><%= item.name %></span>
                    </div>
                  </td>
                  <td>NPR <%= Number(item.price).toFixed(0) %></td>
                  <td>
                    <form action="/cart/update/<%= item.foodId %>" method="post" class="d-flex gap-2 align-items-center">
                      <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="form-control form-control-sm qty-input" />
                      <button class="btn btn-outline-secondary btn-sm">Update</button>
                    </form>
                  </td>
                  <td>NPR <%= Number(item.price * item.quantity).toFixed(0) %></td>
                  <td>
                    <form action="/cart/remove/<%= item.foodId %>" method="post">
                      <button class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="bg-white rounded-4 shadow-sm p-4">
          <h5 class="fw-bold">Order Summary</h5>
          <div class="d-flex justify-content-between"><span>Subtotal</span><span>NPR <%= totals.subtotal.toFixed(0) %></span></div>
          <div class="d-flex justify-content-between"><span>Delivery Fee</span><span>NPR <%= totals.deliveryFee.toFixed(0) %></span></div>
          <hr />
          <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>NPR <%= totals.total.toFixed(0) %></span></div>
          <a href="/orders/checkout" class="btn btn-danger w-100 mt-3">Proceed to Checkout</a>
          <form action="/cart/clear" method="post" class="mt-2">
            <button class="btn btn-outline-secondary w-100">Clear Cart</button>
          </form>
        </div>
      </div>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
