<%- include('partials/header') %>
<div class="container py-4">
  <h1 class="h3 fw-bold mb-4">Checkout</h1>
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="bg-white rounded-4 shadow-sm p-4">
        <form action="/orders/checkout" method="post" class="row g-3">
          <div class="col-12">
            <label class="form-label">Phone Number</label>
            <input type="text" name="phone" class="form-control" value="<%= profile?.phone || '' %>" required />
          </div>
          <div class="col-12">
            <label class="form-label">Delivery Address</label>
            <textarea name="deliveryAddress" class="form-control" rows="3" required><%= profile?.address || '' %></textarea>
          </div>
          <div class="col-12">
            <label class="form-label">Payment Method</label>
            <select class="form-select" name="paymentMethod" required>
              <option value="Cash on Delivery">Cash on Delivery</option>
              <option value="eSewa">eSewa</option>
              <option value="Khalti">Khalti</option>
            </select>
          </div>
          <div class="col-12">
            <button class="btn btn-danger">Place Order</button>
          </div>
        </form>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="bg-white rounded-4 shadow-sm p-4">
        <h5 class="fw-bold">Cart Summary</h5>
        <% cart.forEach(item => { %>
          <div class="d-flex justify-content-between small mb-2">
            <span><%= item.name %> x <%= item.quantity %></span>
            <span>NPR <%= (item.price * item.quantity).toFixed(0) %></span>
          </div>
        <% }) %>
        <hr />
        <div class="d-flex justify-content-between"><span>Subtotal</span><span>NPR <%= totals.subtotal.toFixed(0) %></span></div>
        <div class="d-flex justify-content-between"><span>Delivery Fee</span><span>NPR <%= totals.deliveryFee.toFixed(0) %></span></div>
        <div class="d-flex justify-content-between fw-bold mt-2"><span>Total</span><span>NPR <%= totals.total.toFixed(0) %></span></div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
