<%- include('partials/header') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 fw-bold mb-0">Track Order #<%= order.id %></h1>
    <a href="/orders/my-orders" class="btn btn-outline-secondary btn-sm">Back to My Orders</a>
  </div>
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="bg-white rounded-4 shadow-sm p-4 mb-3">
        <h5 class="fw-bold mb-3">Order Progress</h5>
        <div class="d-flex flex-wrap gap-2">
          <% orderSteps.forEach(step => { %>
            <span class="badge <%= orderSteps.indexOf(step) <= orderSteps.indexOf(order.status) ? 'text-bg-success' : 'text-bg-secondary' %>"><%= step %></span>
          <% }) %>
          <% if (!orderSteps.includes(order.status)) { %>
            <span class="badge text-bg-danger"><%= order.status %></span>
          <% } %>
        </div>
      </div>
      <div class="bg-white rounded-4 shadow-sm p-4">
        <h5 class="fw-bold mb-3">Items</h5>
        <% items.forEach(item => { %>
          <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
            <span><%= item.name %> x <%= item.quantity %></span>
            <span>NPR <%= Number(item.unit_price * item.quantity).toFixed(0) %></span>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="bg-white rounded-4 shadow-sm p-4">
        <h5 class="fw-bold">Delivery Details</h5>
        <p class="mb-1"><strong>Status:</strong> <%= order.status %></p>
        <p class="mb-1"><strong>Phone:</strong> <%= order.phone %></p>
        <p class="mb-1"><strong>Address:</strong> <%= order.delivery_address %></p>
        <p class="mb-1"><strong>Payment:</strong> <%= order.payment_method %></p>
        <p class="mb-0"><strong>Total:</strong> NPR <%= Number(order.total_amount).toFixed(0) %></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
