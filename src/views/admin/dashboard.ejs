<%- include('../partials/header') %>
<div class="container py-4">
  <h1 class="h3 fw-bold mb-4">Admin Dashboard</h1>
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted">Food Items</h6>
          <p class="display-6 mb-0"><%= foodStats %></p>
        </div>
      </div>
    </div>
    <% orderStats.forEach(stat => { %>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h6 class="text-muted"><%= stat.status %> Orders</h6>
            <p class="display-6 mb-0"><%= stat.count %></p>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="d-flex gap-2 mb-3">
    <a href="/admin/foods" class="btn btn-danger">Manage Foods</a>
    <a href="/admin/orders" class="btn btn-outline-danger">Manage Orders</a>
  </div>

  <div class="bg-white rounded-4 shadow-sm p-3">
    <h5 class="fw-bold">Recent Orders</h5>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th>#</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (!recentOrders.length) { %>
            <tr><td colspan="5">No orders yet.</td></tr>
          <% } %>
          <% recentOrders.forEach(order => { %>
            <tr>
              <td>#<%= order.id %></td>
              <td><%= order.customer %></td>
              <td>NPR <%= Number(order.total_amount).toFixed(0) %></td>
              <td><%= order.status %></td>
              <td><%= new Date(order.created_at).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
